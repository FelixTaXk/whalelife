{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": { "whalelife": ["./core/context.ts"] },
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": [
    "core/**/*.ts",
    "examples/**/*.ts",
    "tests/**/*.ts"
  ]
}
